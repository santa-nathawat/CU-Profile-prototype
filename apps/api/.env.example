# Export these variables before running the Go API; it does not load .env files.
PORT=3001
# Without DATABASE_URL the API still starts: health works and other routes return 503.
DATABASE_URL=postgresql://cu_profile:cu_profile@localhost:5432/cu_profile
# Registers POST /auth/demo-sign-in and GET /auth/demo-accounts. Anyone can sign in as any student while this is on.
DEMO_SIGN_IN=true
# Set to true wherever the site is served over HTTPS.
COOKIE_SECURE=false
# Used only by go test. Integration tests skip when it is unset.
TEST_DATABASE_URL=postgresql://cu_profile:cu_profile@localhost:5432/cu_profile_test
